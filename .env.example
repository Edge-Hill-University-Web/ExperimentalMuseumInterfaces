# ─── Copy this file to .env.local and fill in real values. ───────────────────
# Never commit .env.local or any file containing real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=emi
POSTGRES_USER=emi
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://emi:changeme@db:5432/emi

# ─── CMS (Strapi) ────────────────────────────────────────────────────────────
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CMS_URL=http://localhost:1337
CMS_API_TOKEN=changeme
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (transactional) ───────────────────────────────────────────────────
# Provider decision made in Sprint 0 ADR 0004 (to be written).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@emi.computing.edgehill.ac.uk
EMAIL_NOTIFY=walshd@edgehill.ac.uk

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=emi.computing.edgehill.ac.uk

