{
  "name": "@emi/tests",
  "version": "0.0.0",
  "private": true,
  "description": "EMI test suite — BDD, e2e, accessibility, performance, security",
  "scripts": {
    "test:bdd": "cucumber-js",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:a11y": "playwright test --config=playwright.config.ts --grep @accessibility",
    "test:unit": "vitest run --config=vitest.config.ts",
    "test:unit:watch": "vitest --config=vitest.config.ts",
    "test:perf": "lhci autorun"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@cucumber/cucumber": "^10.0.0",
    "@cucumber/html-formatter": "^21.0.0",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-istanbul": "^1.0.0",
    "axe-core": "^4.9.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
